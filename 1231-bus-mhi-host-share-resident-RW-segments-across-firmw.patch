 }
 
 /**
- * mhi_analyze_elf_for_ro_segments - Analyze ELF to find RO/RW boundary
+ * mhi_analyze_elf_for_shared_segments - Analyze ELF to find shared/private
+ *                                       segment boundary
  * @mhi_cntrl: MHI controller
  * @elf2_data: Pointer to second ELF data
