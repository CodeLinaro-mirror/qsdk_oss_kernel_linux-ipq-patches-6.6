+	 * pageable/remote segment exists.
+	 */
 	dev_dbg(dev, "Analyzing second ELF: %u program headers\n", ehdr->e_phnum);
 	for (i = 0; i < ehdr->e_phnum; i++) {
 		struct elf32_phdr *phdr = &phdrs[i];
+		size_t seg_end = phdr->p_offset + phdr->p_filesz;
+
