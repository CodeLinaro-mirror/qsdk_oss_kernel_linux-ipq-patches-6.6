From 96ae17ec6949546922598a9f7409d17ae7703b7a Mon Sep 17 00:00:00 2001
From: Sridharan S N <sridsn@qti.qualcomm.com>
Date: Fri, 26 Jun 2026 19:07:29 +0530
Subject: [PATCH] bus: mhi: host: sync RDDM data segments for CPU access after
 transfer

RDDM data segments are mapped with dma_map_single(DMA_FROM_DEVICE)
in mhi_alloc_bhie_table(). After the device writes RDDM data to
physical memory via DMA, the CPU cache may hold stale zeros from
the original kmalloc(). This causes mhi_buf->buf (virtual address)
to read as zeros while the actual data is visible only at the
physical address (dma_addr).

Call dma_sync_single_for_cpu(DMA_FROM_DEVICE) for all RDDM data
segments after the transfer completes to invalidate the CPU cache
and make the SFR/coredump data visible through the virtual address.

Change-Id: I91387a31545e90d670c968333868301adc8bdb0c
Signed-off-by: Sridharan S N <sridsn@qti.qualcomm.com>
---
 drivers/bus/mhi/host/boot.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/bus/mhi/host/boot.c b/drivers/bus/mhi/host/boot.c
index 55a9989740fa..d3b9ef41df74 100644
--- a/drivers/bus/mhi/host/boot.c
+++ b/drivers/bus/mhi/host/boot.c
@@ -251,6 +251,27 @@ int mhi_download_rddm_image(struct mhi_controller *mhi_cntrl, bool in_panic)
 		dma_unmap_single(mhi_cntrl->cntrl_dev, mhi_buf->dma_addr,
 				 mhi_buf->len, DMA_TO_DEVICE);
 
+	/*
+	 * Sync all RDDM data segments for CPU access. The data segments
+	 * (all entries except the last vector table entry) were mapped with
+	 * DMA_FROM_DEVICE in mhi_alloc_bhie_table(). After the device writes
+	 * RDDM data via DMA, the CPU cache may still hold stale data (zeros
+	 * from the initial kmalloc). Without this sync, reading mhi_buf->buf
+	 * (virtual address) returns zeros while the actual data is only
+	 * visible at the physical/DMA address. This is the root cause of
+	 * SFR/coredump not being displayed from the virtual address buffer.
+	 */
+	if (!mhi_cntrl->rddm_prealloc) {
+		struct mhi_buf *data_buf = mhi_cntrl->rddm_image->mhi_buf;
+		unsigned int j;
+
+		for (j = 0; j < mhi_cntrl->rddm_image->entries - 1; j++, data_buf++)
+			dma_sync_single_for_cpu(mhi_cntrl->cntrl_dev,
+						data_buf->dma_addr,
+						data_buf->len,
+						DMA_FROM_DEVICE);
+	}
+
 	if (ret) {
 		dev_err(dev, "RDDM transfer failed. RXVEC_STATUS: 0x%x\n",
 			rx_status);
-- 
2.34.1

