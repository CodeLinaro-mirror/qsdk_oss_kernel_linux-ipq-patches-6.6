From 7d494560f39166630218f6de21e614dc1e398699 Mon Sep 17 00:00:00 2001
From: Kathiravan Thirumoorthy <kathirav@qti.qualcomm.com>
Date: Thu, 1 Oct 2026 11:02:11 +0530
Subject: [PATCH] ARM: dma-mapping: set IOMMU_CACHE for coherent devices

For devices marked dma-coherent, the ARM IOMMU DMA ops hand out
buffers through the cacheable linear mapping and skip CPU cache
maintenance, relying on the hardware to snoop the CPU caches.
However, __dma_info_to_prot() never sets IOMMU_CACHE, so the IOMMU
page table entries are created with non-cacheable memory attributes.
Device accesses through such mappings are not snooped and can observe
stale data from DRAM while the up-to-date data is still in the CPU
caches.

This was seen with FastRPC on IPQ9650 running a 32-bit kernel, where
the CDSP read garbage from the invoke header buffer written by the
CPU and crashed. The same setup works on a 64-bit kernel, since
dma-iommu already sets IOMMU_CACHE for coherent devices.

Pass the device coherency to __dma_info_to_prot() and set IOMMU_CACHE
accordingly, matching dma_info_to_prot() in dma-iommu. As in
iommu_dma_map_resource(), MMIO mappings are always treated as
non-coherent.

Change-Id: I71a8de6856cecbca1a49299e3196dfe168b3ec6f
Signed-off-by: Kathiravan Thirumoorthy <kathirav@qti.qualcomm.com>
---
 arch/arm/mm/dma-mapping.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/arch/arm/mm/dma-mapping.c b/arch/arm/mm/dma-mapping.c
index 5409225b4abc..3bf371cc327c 100644
--- a/arch/arm/mm/dma-mapping.c
+++ b/arch/arm/mm/dma-mapping.c
@@ -730,9 +730,10 @@ static void __dma_page_dev_to_cpu(struct page *page, unsigned long off,
 
 #ifdef CONFIG_ARM_DMA_USE_IOMMU
 
-static int __dma_info_to_prot(enum dma_data_direction dir, unsigned long attrs)
+static int __dma_info_to_prot(enum dma_data_direction dir, bool coherent,
+			      unsigned long attrs)
 {
-	int prot = 0;
+	int prot = coherent ? IOMMU_CACHE : 0;
 
 	if (attrs & DMA_ATTR_PRIVILEGED)
 		prot |= IOMMU_PRIV;
@@ -988,7 +989,8 @@ __iommu_create_mapping(struct device *dev, struct page **pages, size_t size,
 
 		len = (j - i) << PAGE_SHIFT;
 		ret = iommu_map(mapping->domain, iova, phys, len,
-				__dma_info_to_prot(DMA_BIDIRECTIONAL, attrs),
+				__dma_info_to_prot(DMA_BIDIRECTIONAL,
+						   dev->dma_coherent, attrs),
 				GFP_KERNEL);
 		if (ret < 0)
 			goto fail;
@@ -1210,7 +1212,7 @@ static int __map_sg_chunk(struct device *dev, struct scatterlist *sg,
 		if (!dev->dma_coherent && !(attrs & DMA_ATTR_SKIP_CPU_SYNC))
 			__dma_page_cpu_to_dev(sg_page(s), s->offset, s->length, dir);
 
-		prot = __dma_info_to_prot(dir, attrs);
+		prot = __dma_info_to_prot(dir, dev->dma_coherent, attrs);
 
 		ret = iommu_map(mapping->domain, iova, phys, len, prot,
 				GFP_KERNEL);
@@ -1383,7 +1385,7 @@ static dma_addr_t arm_iommu_map_page(struct device *dev, struct page *page,
 	if (dma_addr == DMA_MAPPING_ERROR)
 		return dma_addr;
 
-	prot = __dma_info_to_prot(dir, attrs);
+	prot = __dma_info_to_prot(dir, dev->dma_coherent, attrs);
 
 	ret = iommu_map(mapping->domain, dma_addr, page_to_phys(page), len,
 			prot, GFP_KERNEL);
@@ -1448,7 +1450,7 @@ static dma_addr_t arm_iommu_map_resource(struct device *dev,
 	if (dma_addr == DMA_MAPPING_ERROR)
 		return dma_addr;
 
-	prot = __dma_info_to_prot(dir, attrs) | IOMMU_MMIO;
+	prot = __dma_info_to_prot(dir, false, attrs) | IOMMU_MMIO;
 
 	ret = iommu_map(mapping->domain, dma_addr, addr, len, prot, GFP_KERNEL);
 	if (ret < 0)
