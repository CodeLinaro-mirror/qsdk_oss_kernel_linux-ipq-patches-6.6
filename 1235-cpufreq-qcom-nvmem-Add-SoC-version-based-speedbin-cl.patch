From e39f750b8f580b4bbd1370b9f980d204aeb66ac9 Mon Sep 17 00:00:00 2001
From: Devi Priya <devipriy@qti.qualcomm.com>
Date: Thu, 3 Sep 2026 20:57:44 +0530
Subject: [PATCH] cpufreq: qcom-nvmem: Add SoC version based speedbin
 classification for IPQ96xx

Gold (A78/cpu4) cluster OPPs need higher frequencies gated by both
SoC major version and the speedbin fuse, while cpu0_opp_table
entries should remain unchanged. Add support to read the soc version and
support the cluster OPPs based on major version and speedbin fuse.

Change-Id: I455694e66a3a9e14a185d935e20421e130d56dac
Signed-off-by: Devi Priya <devipriy@qti.qualcomm.com>
---
 drivers/cpufreq/qcom-cpufreq-nvmem.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/cpufreq/qcom-cpufreq-nvmem.c b/drivers/cpufreq/qcom-cpufreq-nvmem.c
index 679fbd18c8a3..dd9902c27c96 100644
--- a/drivers/cpufreq/qcom-cpufreq-nvmem.c
+++ b/drivers/cpufreq/qcom-cpufreq-nvmem.c
@@ -137,6 +137,7 @@ static int qcom_cpufreq_kryo_name_version(struct device *cpu_dev,
 {
 	size_t len;
 	u32 msm_id;
+	u32 soc_version = 0;
 	u8 *speedbin;
 	int ret;
 	*pvs_name = NULL;
@@ -145,6 +146,10 @@ static int qcom_cpufreq_kryo_name_version(struct device *cpu_dev,
 	if (ret)
 		return ret;
 
+	ret = qcom_smem_get_soc_major_version(&soc_version);
+	if (ret)
+		dev_err(cpu_dev, "Unable to read SoC version, defaulting to 0!\n");
+
 	speedbin = nvmem_cell_read(speedbin_nvmem, &len);
 	if (IS_ERR(speedbin))
 		return PTR_ERR(speedbin);
@@ -182,7 +187,13 @@ static int qcom_cpufreq_kryo_name_version(struct device *cpu_dev,
 	case QCOM_ID_IPQ9640:
 	case QCOM_ID_IPQ9650:
 	case QCOM_ID_IPQ9670:
-		drv->versions =  (*speedbin != 0x4b) ? BIT(0) : BIT(1);
+		/* SoC version based support for speedbin classification as
+		 * v1.0 and v2.0 now support different OPP frequencies for A78
+		 */
+		if (soc_version == 2)
+			drv->versions = (*speedbin != 0x4b) ? BIT(2) : BIT(3);
+		else
+			drv->versions = (*speedbin != 0x4b) ? BIT(0) : BIT(1);
 		break;
 	case QCOM_ID_MSM8996SG:
 	case QCOM_ID_APQ8096SG:
-- 
2.34.1

