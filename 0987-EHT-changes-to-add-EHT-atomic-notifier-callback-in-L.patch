 };
@@ -369,6 +375,9 @@ struct net_bridge_port_group {
 	struct rhash_head		rhnode;
 	struct net_bridge_mcast_gc	mcast_gc;
 	struct rcu_head			rcu;
+#if IS_ENABLED(CONFIG_BRIDGE_MCAST_OFFLOAD)
