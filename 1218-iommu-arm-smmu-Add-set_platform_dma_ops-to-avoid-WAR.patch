From 32e5adc582d4eba374c9ec04514ad1a4ded05be6 Mon Sep 17 00:00:00 2001
From: Kathiravan Thirumoorthy <kathirav@qti.qualcomm.com>
Date: Fri, 17 Jul 2026 14:35:30 +0530
Subject: [PATCH] iommu/arm-smmu: Add set_platform_dma_ops to avoid WARN_ON
 during SSR

On 32-bit builds, this teardown goes through arch_teardown_dma_ops()
-> arm_iommu_detach_device() -> iommu_detach_device(), which resolves
to a NULL target domain and hits WARN_ON(!ops->set_platform_dma_ops) in
__iommu_group_set_domain_internal(). With panic_on_warn=1 this
escalates to a kernel panic.

arm_smmu_ops never implemented set_platform_dma_ops, so add it.
Reset the S2CR entries for the device's SMEs to their init value
(BYPASS/FAULT depending on disable_bypass), matching how the S2CR
table is initialised and cleared everywhere else in this driver.
This only touches the device's own stream mappings, not the shared
context bank/page tables owned by the domain, since those can still
be in use by other devices attached to the same domain and are torn
down separately in arm_smmu_domain_free().

Change-Id: Ie28dea08f87cc94423d1d7caf7a2ff95b936772e
Signed-off-by: Kathiravan Thirumoorthy <kathirav@qti.qualcomm.com>
---
 drivers/iommu/arm/arm-smmu/arm-smmu.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
index f1008f15ce43..262a0be8b1f8 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -1143,6 +1143,28 @@ static int arm_smmu_domain_add_master(struct arm_smmu_domain *smmu_domain,
 	return 0;
 }
 
+static void arm_smmu_set_platform_dma(struct device *dev)
+{
+	struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+	struct arm_smmu_master_cfg *cfg = dev_iommu_priv_get(dev);
+	struct arm_smmu_device *smmu = cfg->smmu;
+	struct arm_smmu_s2cr *s2cr = smmu->s2crs;
+	int i, idx, ret;
+
+	ret = arm_smmu_rpm_get(smmu);
+	if (ret < 0)
+		return;
+
+	mutex_lock(&smmu->stream_map_mutex);
+	for_each_cfg_sme(cfg, fwspec, i, idx) {
+		s2cr[idx] = s2cr_init_val;
+		arm_smmu_write_s2cr(smmu, idx);
+	}
+	mutex_unlock(&smmu->stream_map_mutex);
+
+	arm_smmu_rpm_put(smmu);
+}
+
 static int arm_smmu_attach_dev(struct iommu_domain *domain, struct device *dev)
 {
 	struct arm_smmu_domain *smmu_domain = to_smmu_domain(domain);
@@ -1615,6 +1637,7 @@ static struct iommu_ops arm_smmu_ops = {
 	.of_xlate		= arm_smmu_of_xlate,
 	.get_resv_regions	= arm_smmu_get_resv_regions,
 	.def_domain_type	= arm_smmu_def_domain_type,
+	.set_platform_dma_ops	= arm_smmu_set_platform_dma,
 	.pgsize_bitmap		= -1UL, /* Restricted during device attach */
 	.owner			= THIS_MODULE,
 	.default_domain_ops = &(const struct iommu_domain_ops) {
-- 
2.34.1

