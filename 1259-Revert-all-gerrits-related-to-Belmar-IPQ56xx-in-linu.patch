 	select ARM_GIC_V3
 
-config ARCH_IPQ5610
-	bool "Enable support for IPQ5610"
-	select ARM_GIC_V3
-
 config ARCH_MSM8X60
 	bool "Enable support for MSM8X60"
 	select CLKSRC_QCOM
diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index e91f958253fb..44979462496f 100644
