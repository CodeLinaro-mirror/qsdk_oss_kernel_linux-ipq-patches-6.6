From 8394b35f5236025eb70fa5a1940cbc02194d4cda Mon Sep 17 00:00:00 2001
From: Pratik Tripathi <pratikt@qti.qualcomm.com>
Date: Wed, 7 Oct 2026 14:55:33 +0530
Subject: [PATCH] net: sock: Add dedicated sk_offload_ctx pointer to struct
 sock

Add a new void pointer sk_offload_ctx for socket offload context
storage, sk_user_data used previously is shared by multiple kernel
subsystem.

Change-Id: I28a5d128e428db127fa37c4938144529ade7af9d
Signed-off-by: Pratik Tripathi <pratikt@qti.qualcomm.com>
(cherry picked from commit dc30b087fc6b1071ac8dce1d6bde3cfa13ad78f7)
---
 include/net/sock.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/include/net/sock.h b/include/net/sock.h
index 2d380d7e6d4d..43514c4e79ca 100644
--- a/include/net/sock.h
+++ b/include/net/sock.h
@@ -540,6 +540,7 @@ struct sock {
 
 	struct socket		*sk_socket;
 	void			*sk_user_data;
+	void			*sk_offload_ctx;
 #ifdef CONFIG_SECURITY
 	void			*sk_security;
 #endif
-- 
2.34.1

