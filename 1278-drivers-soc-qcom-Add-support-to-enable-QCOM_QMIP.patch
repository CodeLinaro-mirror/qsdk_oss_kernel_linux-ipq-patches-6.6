From 5ff4e199dc6f1d4124dfca6f06356315b43cf850 Mon Sep 17 00:00:00 2001
From: Sai Swetha Manonmayee Bharatula <sbharatu@qti.qualcomm.com>
Date: Fri, 9 Oct 2026 13:29:44 +0530
Subject: [PATCH] drivers: soc: qcom: Add support to enable QCOM_QMIP

Change-Id: I5874b08595fa07d63dbaba96b859ba2a39ba596c
Signed-off-by: Sai Swetha Manonmayee Bharatula <sbharatu@qti.qualcomm.com>
---
 drivers/soc/qcom/Kconfig  | 10 ++++++++++
 drivers/soc/qcom/Makefile |  1 +
 2 files changed, 11 insertions(+)

diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 3d84400be3f5..4322d6603683 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -77,6 +77,16 @@ config QCOM_LLCC
 	  SDM845. This provides interfaces to clients that use the LLCC.
 	  Say yes here to enable LLCC slice driver.
 
+config QCOM_QMIP
+	tristate "Qualcomm Technologies, Inc. QMIP driver"
+        depends on (ARCH_QCOM || COMPILE_TEST) && ARM64
+	default n
+	help
+	  Qualcomm Technologies, Inc. platform specific
+	  QoS Management IP(QMIP) driver for platforms such as, IPQ9650.
+	  This block is used to monitor and regulate DDR bandwidth usage
+	  across subsystems. Say yes here to enable QMIP driver.
+
 config QCOM_KRYO_L2_ACCESSORS
 	bool
 	depends on (ARCH_QCOM || COMPILE_TEST) && ARM64
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index fa336697d135..351a65a50bab 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -29,6 +29,7 @@ obj-$(CONFIG_QCOM_WCNSS_CTRL) += wcnss_ctrl.o
 obj-$(CONFIG_QCOM_APR) += apr.o
 obj-$(CONFIG_QCOM_LLCC) += llcc-qcom.o
 obj-$(CONFIG_QCOM_LLCC_PERFMON) += llcc_perfmon.o
+obj-$(CONFIG_QCOM_QMIP) += qmip.o
 obj-$(CONFIG_QCOM_KRYO_L2_ACCESSORS) +=	kryo-l2-accessors.o
 obj-$(CONFIG_QCOM_ICC_BWMON)	+= icc-bwmon.o
 qcom_ice-objs			+= ice.o
-- 
2.34.1

