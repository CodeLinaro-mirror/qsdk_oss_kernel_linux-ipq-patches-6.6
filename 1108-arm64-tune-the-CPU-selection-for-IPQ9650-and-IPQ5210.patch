From 8e6683b61d99606d8b5c60daef31e15b8f1e6147 Mon Sep 17 00:00:00 2001
From: Sridharan S N <sridsn@qti.qualcomm.com>
Date: Sun, 29 Mar 2026 21:35:34 +0530
Subject: [PATCH] arm64: tune the CPU selection for IPQ9650 and IPQ5210

Change-Id: I2a70084e17e621e4baf83412bf5b2bcb81ec1676
Signed-off-by: Sridharan S N <sridsn@qti.qualcomm.com>
---
 arch/arm64/Kconfig | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 1fe85ac1fc1f..8f513fb42b03 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -1965,7 +1965,8 @@ config CC_HAS_SIGN_RETURN_ADDRESS
 	def_bool $(cc-option,-msign-return-address=all)
 
 config AS_HAS_ARMV8_3
-	def_bool $(cc-option,-Wa$(comma)-march=armv8.3-a) if !ARCH_IPQ5424
+	def_bool $(cc-option,-Wa$(comma)-march=armv8.3-a)
+	depends on !ARCH_IPQ5424 && !ARCH_IPQ9650 && !ARCH_IPQ5210
 
 config AS_HAS_CFI_NEGATE_RA_STATE
 	def_bool $(as-instr,.cfi_startproc\n.cfi_negate_ra_state\n.cfi_endproc\n)
@@ -2001,7 +2002,8 @@ config ARM64_AMU_EXTN
 	  indicating that the counter is not enabled.
 
 config AS_HAS_ARMV8_4
-	def_bool $(cc-option,-Wa$(comma)-march=armv8.4-a) if !ARCH_IPQ5424
+	def_bool $(cc-option,-Wa$(comma)-march=armv8.4-a)
+	depends on !ARCH_IPQ5424 && !ARCH_IPQ9650 && !ARCH_IPQ5210
 
 config ARM64_TLB_RANGE
 	bool "Enable support for tlbi range feature"
@@ -2019,7 +2021,8 @@ endmenu # "ARMv8.4 architectural features"
 menu "ARMv8.5 architectural features"
 
 config AS_HAS_ARMV8_5
-	def_bool $(cc-option,-Wa$(comma)-march=armv8.5-a) if !ARCH_IPQ5424
+	def_bool $(cc-option,-Wa$(comma)-march=armv8.5-a)
+	depends on !ARCH_IPQ5424 && !ARCH_IPQ9650 && !ARCH_IPQ5210
 
 config ARM64_BTI
 	bool "Branch Target Identification support"
@@ -2253,7 +2256,7 @@ config CC_HAVE_STACKPROTECTOR_SYSREG
 	def_bool $(cc-option,-mstack-protector-guard=sysreg -mstack-protector-guard-reg=sp_el0 -mstack-protector-guard-offset=0)
 
 config STACKPROTECTOR_PER_TASK
-	def_bool y if !ARCH_IPQ5424
+	depends on !ARCH_IPQ5424 && !ARCH_IPQ9650 && !ARCH_IPQ5210
 	depends on STACKPROTECTOR && CC_HAVE_STACKPROTECTOR_SYSREG
 
 config IPQ_MEM_PROFILE
@@ -2277,6 +2280,12 @@ config UNWIND_PATCH_PAC_INTO_SCS
 config ARCH_IPQ5424
 	bool "Enable for target IPQ5424"
 
+config ARCH_IPQ9650
+	bool "Enable for target IPQ9650"
+
+config ARCH_IPQ5210
+	bool "Enable for target IPQ5210"
+
 config IO_COHERENCY
 	bool "Enable IO Coherency for kernel modules"
 	default n
-- 
2.34.1

