From 7d075e3fffab9e7b8190f4e7b8ea70a4a52e534d Mon Sep 17 00:00:00 2001
From: Sridharan S N <sridsn@qti.qualcomm.com>
Date: Tue, 4 Aug 2026 07:07:22 +0530
Subject: [PATCH] hrtimer: Fix __hrtimer_start_range_ns_on_cpu() build after
 6.6.147 merge

Upstream commit ca2d280b9b380 ("hrtimer: Force clock_was_set() when
PREEMPT_RT is enabled") added a was_armed parameter to
enqueue_hrtimer()/debug_activate(), threaded from remove_hrtimer()'s
return value. __hrtimer_start_range_ns_on_cpu() is a downstream-only
function not touched by the merge, so it was left calling the old
signature. Capture remove_hrtimer()'s return value into was_armed and
pass it to enqueue_hrtimer(), matching the sibling function
__hrtimer_start_range_ns().

Change-Id: Ica87eddedd469eba283a52cc8e05ef149337c9c4
Signed-off-by: Sridharan S N <sridsn@qti.qualcomm.com>
---
 kernel/time/hrtimer.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/kernel/time/hrtimer.c b/kernel/time/hrtimer.c
index 9e3cf5f9df76..ec6693cf783d 100644
--- a/kernel/time/hrtimer.c
+++ b/kernel/time/hrtimer.c
@@ -1232,7 +1232,7 @@ static int __hrtimer_start_range_ns_on_cpu(struct hrtimer *timer, ktime_t tim,
 				    struct hrtimer_clock_base *base)
 {
 	struct hrtimer_clock_base *new_base;
-	bool force_local, first;
+	bool force_local, first, was_armed;
 
 	/*
 	 * If the timer is on the local cpu base and is the first expiring
@@ -1256,7 +1256,7 @@ static int __hrtimer_start_range_ns_on_cpu(struct hrtimer *timer, ktime_t tim,
 	 * avoids programming the underlying clock event twice (once at
 	 * removal and once after enqueue).
 	 */
-	remove_hrtimer(timer, base, true, force_local);
+	was_armed = remove_hrtimer(timer, base, true, force_local);
 
 	if (mode & HRTIMER_MODE_REL)
 		tim = ktime_add_safe(tim, base->get_time());
@@ -1267,7 +1267,7 @@ static int __hrtimer_start_range_ns_on_cpu(struct hrtimer *timer, ktime_t tim,
 
 	new_base = base;
 
-	first = enqueue_hrtimer(timer, new_base, mode);
+	first = enqueue_hrtimer(timer, new_base, mode, was_armed);
 	if (!force_local)
 		return first;
 
