From cbb77bc638ce3519dd9bb2659238ce13bb63a7f5 Mon Sep 17 00:00:00 2001
From: Prateek Sharma <prsha@qti.qualcomm.com>
Date: Thu, 2 Apr 2026 12:23:24 +0530
Subject: [PATCH] net: Add support for IPv6 proxy ND Wi-Fi and DAD handling

This Change modifies the Linux kernel bridge subsystem (net/bridge/) to add proxy ND support for WiFi ports. The key changes are:

br_input.c: Removes the BROPT_NEIGH_SUPPRESS_ENABLED guard from the IPv6 ND processing path in br_handle_frame_finish, allowing br_do_suppress_nd to be called unconditionally for ICMPv6 packets.
br_arp_nd_proxy.c: Refactors br_do_suppress_nd logic, adds BR_PROXYARP_WIFI support for ND proxy replies, fixes a DAD (Duplicate Address Detection) packet handling, and fixes the ND reply destination address for DAD solicitations.


Change-Id: I5041e48d3228e77e022d8c1ec682091419f7f1e7
Signed-off-by: Prateek Sharma <prsha@qti.qualcomm.com>
---
 net/bridge/br_arp_nd_proxy.c | 39 +++++++++++++++++++++++-------------
 net/bridge/br_input.c        |  1 -
 2 files changed, 25 insertions(+), 15 deletions(-)

diff --git a/net/bridge/br_arp_nd_proxy.c b/net/bridge/br_arp_nd_proxy.c
index c7869a286df4..e179123ba185 100644
--- a/net/bridge/br_arp_nd_proxy.c
+++ b/net/bridge/br_arp_nd_proxy.c
@@ -315,7 +315,7 @@ static void br_nd_send(struct net_bridge
 	pip6->priority = ipv6_hdr(request)->priority;
 	pip6->nexthdr = IPPROTO_ICMPV6;
 	pip6->hop_limit = 255;
-	pip6->daddr = ipv6_hdr(request)->saddr;
+	pip6->daddr = ipv6_addr_any(&(ipv6_hdr(request)->saddr)) ? in6addr_linklocal_allnodes : ipv6_hdr(request)->saddr;
 	pip6->saddr = *(struct in6_addr *)n->primary_key;
 
 	skb_pull(reply, sizeof(struct ipv6hdr));
@@ -412,14 +412,16 @@ void br_do_suppress_nd(struct sk_buff *s
 
 	BR_INPUT_SKB_CB(skb)->proxyarp_replied = 0;
 
-	if (br_is_neigh_suppress_enabled(p, vid))
-		return;
+	if (br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED)) {
+		if (br_is_neigh_suppress_enabled(p, vid))
+			return;
 
-	if (msg->icmph.icmp6_type == NDISC_NEIGHBOUR_ADVERTISEMENT &&
-	    !msg->icmph.icmp6_solicited) {
-		/* prevent flooding to neigh suppress ports */
-		BR_INPUT_SKB_CB(skb)->proxyarp_replied = 1;
-		return;
+		if (msg->icmph.icmp6_type == NDISC_NEIGHBOUR_ADVERTISEMENT &&
+		    !msg->icmph.icmp6_solicited) {
+			/* prevent flooding to neigh suppress ports */
+			BR_INPUT_SKB_CB(skb)->proxyarp_replied = 1;
+			return;
+		}
 	}
 
 	if (msg->icmph.icmp6_type != NDISC_NEIGHBOUR_SOLICITATION)
@@ -429,10 +431,17 @@ void br_do_suppress_nd(struct sk_buff *s
 	saddr = &iphdr->saddr;
 	daddr = &iphdr->daddr;
 
-	if (ipv6_addr_any(saddr) || !ipv6_addr_cmp(saddr, daddr)) {
-		/* prevent flooding to neigh suppress ports */
-		BR_INPUT_SKB_CB(skb)->proxyarp_replied = 1;
-		return;
+	if (br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED)) {
+		if (!ipv6_addr_cmp(saddr, daddr)) {
+			/* prevent flooding to neigh suppress ports */
+			BR_INPUT_SKB_CB(skb)->proxyarp_replied = 1;
+			return;
+		}
+
+		if (ipv6_addr_any(saddr)) {
+			/* prevent flooding to neigh suppress ports */
+			BR_INPUT_SKB_CB(skb)->proxyarp_replied = 1;
+		}
 	}
 
 	if (vid != 0) {
@@ -445,7 +454,8 @@ void br_do_suppress_nd(struct sk_buff *s
 		vlandev = dev;
 	}
 
-	if (br_is_local_ip6(vlandev, &msg->target)) {
+	if (br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED) &&
+	    br_is_local_ip6(vlandev, &msg->target)) {
 		/* its our own ip, so don't proxy reply
 		 * and don't forward to arp suppress ports
 		 */
@@ -467,7 +477,8 @@ void br_do_suppress_nd(struct sk_buff *s
 			const struct net_bridge_port *dst = READ_ONCE(f->dst);
 			bool replied = false;
 
-			if (br_is_neigh_suppress_enabled(dst, vid)) {
+			if (br_is_neigh_suppress_enabled(dst, vid) ||
+			    (dst && (dst->flags & BR_PROXYARP_WIFI))) {
 				if (vid != 0)
 					br_nd_send(br, p, skb, n,
 						   skb->vlan_proto,
diff --git a/net/bridge/br_input.c b/net/bridge/br_input.c
index c59df3fd87c8..612264b78781 100644
--- a/net/bridge/br_input.c
+++ b/net/bridge/br_input.c
@@ -181,7 +181,6 @@ int br_handle_frame_finish(struct net *n
 		br_do_proxy_suppress_arp(skb, br, vid, p);
 	} else if (ipv6_mod_enabled() &&
 		   skb->protocol == htons(ETH_P_IPV6) &&
-		   br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED) &&
 		   pskb_may_pull(skb, sizeof(struct ipv6hdr) +
 				 sizeof(struct nd_msg)) &&
 		   ipv6_hdr(skb)->nexthdr == IPPROTO_ICMPV6) {
