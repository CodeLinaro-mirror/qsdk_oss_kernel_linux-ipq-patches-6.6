From 9ae133b3cdbf78bb035d9b64cb95fb7ed09e5189 Mon Sep 17 00:00:00 2001
From: Sridharan S N <sridsn@qti.qualcomm.com>
Date: Wed, 12 Aug 2026 12:22:09 +0530
Subject: [PATCH] soc: qcom: socinfo: Add new SoC IDs for IPQ52xx

Add SoC IDs for IPQ5211 and QCF3211

Change-Id: I807cf32130807c0cf8600bf052d8a3a61b5807b7
Signed-off-by: Sridharan S N <sridsn@qti.qualcomm.com>
---
 drivers/soc/qcom/socinfo.c         | 2 ++
 include/dt-bindings/arm/qcom,ids.h | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/drivers/soc/qcom/socinfo.c b/drivers/soc/qcom/socinfo.c
index 2d8361422828..dc2465841a47 100644
--- a/drivers/soc/qcom/socinfo.c
+++ b/drivers/soc/qcom/socinfo.c
@@ -421,9 +421,11 @@ static const struct soc_id soc_id[] = {
 	{ qcom_board_id(IPQ5404) },
 	{ qcom_board_id(IPQ5200) },
 	{ qcom_board_id(IPQ5210) },
+	{ qcom_board_id(IPQ5211) },
 	{ qcom_board_id(QCF2200) },
 	{ qcom_board_id(QCF3200) },
 	{ qcom_board_id(QCF3210) },
+	{ qcom_board_id(QCF3211) },
 	{ qcom_board_id(IPQ9620) },
 	{ qcom_board_id(IPQ9650) },
 	{ qcom_board_id(IPQ9670) },
diff --git a/include/dt-bindings/arm/qcom,ids.h b/include/dt-bindings/arm/qcom,ids.h
index 6926e428cb28..6dd0d7fa1d40 100644
--- a/include/dt-bindings/arm/qcom,ids.h
+++ b/include/dt-bindings/arm/qcom,ids.h
@@ -274,6 +274,8 @@
 #define QCOM_ID_IPQ9640			780
 #define QCOM_ID_IPQ9630			779
 #define QCOM_ID_IPQ9610			778
+#define QCOM_ID_QCF3211			801
+#define QCOM_ID_IPQ5211			802
 
