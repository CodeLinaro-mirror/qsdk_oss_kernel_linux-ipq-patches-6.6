From cc01d1a3d4eeb667ebd6f2358ba1e723ed40b437 Mon Sep 17 00:00:00 2001
From: Vignesh Viswanathan <viswanat@qti.qualcomm.com>
Date: Wed, 30 Sep 2026 12:18:24 +0530
Subject: [PATCH] bus: mhi: Restrict boot-args and license download to QCN9224

Boot-args and license transfer via PCIe scratch registers is a
QCN9224-specific mechanism. Invoking mhi_handle_boot_args(),
mhi_download_fw_license(), and their corresponding cleanup routines
mhi_free_nonce_buffer() and mhi_free_boot_args() on QCN9625/QCN9589
causes random NOC errors on those devices since the scratch
registers are not meant to be accessed this way there.

Gate all four boot_lm.c entry points (in boot.c and pm.c) behind a
QCN9224_DEVICE_NUM check so no call lands in boot_lm.c for other
device types.

Change-Id: I5c6161cc86689719218a5f00355a37b0606ee4a8
Signed-off-by: Vignesh Viswanathan <viswanat@qti.qualcomm.com>
---
 drivers/bus/mhi/host/boot.c | 15 ++++++++-------
 drivers/bus/mhi/host/pm.c   |  6 ++++--
 2 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/drivers/bus/mhi/host/boot.c b/drivers/bus/mhi/host/boot.c
index 2d597a392c2b..2966ba005fe6 100644
--- a/drivers/bus/mhi/host/boot.c
+++ b/drivers/bus/mhi/host/boot.c
@@ -1315,15 +1315,16 @@ int mhi_download_amss_image(struct mhi_controller *mhi_cntrl)
 	if (!image_info)
 		return -EIO;
 
-	ret = mhi_handle_boot_args(mhi_cntrl);
-	if(ret) {
-		dev_err(dev, "Failed to handle the boot-args, ret: %d\n",ret);
-		return ret;
-	}
+	if (mhi_cntrl->device_number == QCN9224_DEVICE_NUM) {
+		ret = mhi_handle_boot_args(mhi_cntrl);
+		if (ret) {
+			dev_err(dev, "Failed to handle the boot-args, ret: %d\n", ret);
+			return ret;
+		}
 
-	/* Download the License */
-	if (mhi_cntrl->device_number == QCN9224_DEVICE_NUM)
+		/* Download the License */
 		mhi_download_fw_license(mhi_cntrl);
+	}
 
 	ret = mhi_fw_load_bhie(mhi_cntrl,
 			       /* Vector table is the last entry */
diff --git a/drivers/bus/mhi/host/pm.c b/drivers/bus/mhi/host/pm.c
index 5716f6f50279..2e17b0921381 100644
--- a/drivers/bus/mhi/host/pm.c
+++ b/drivers/bus/mhi/host/pm.c
@@ -464,7 +464,8 @@ static int mhi_pm_mission_mode_transition(struct mhi_controller *mhi_cntrl)
 	read_unlock_bh(&mhi_cntrl->pm_lock);
 
 	/* Free NONCE and ECDSA buffer */
-	mhi_free_nonce_buffer(mhi_cntrl);
+	if (mhi_cntrl->device_number == QCN9224_DEVICE_NUM)
+		mhi_free_nonce_buffer(mhi_cntrl);
 
 	if (mhi_cntrl->license_buf) {
 		lm_free_license(mhi_cntrl->license_buf,
@@ -1239,7 +1240,8 @@ void mhi_power_down(struct mhi_controller *mhi_cntrl, bool graceful)
 
 	disable_irq(mhi_cntrl->irq[0]);
 
-	mhi_free_boot_args(mhi_cntrl);
+	if (mhi_cntrl->device_number == QCN9224_DEVICE_NUM)
+		mhi_free_boot_args(mhi_cntrl);
 }
 EXPORT_SYMBOL_GPL(mhi_power_down);
 
-- 
