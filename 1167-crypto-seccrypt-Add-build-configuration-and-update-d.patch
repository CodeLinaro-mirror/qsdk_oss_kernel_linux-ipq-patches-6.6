From 88fb713bd8e5a8582813271b9986ba828f6b8ff8 Mon Sep 17 00:00:00 2001
From: Ananya Ghosh <ananghos@qti.qualcomm.com>
Date: Wed, 6 May 2026 11:24:51 +0530
Subject: [PATCH] crypto: seccrypt: Add build configuration and update driver
 for ops framework

Add Kconfig and Makefile support for the seccrypt operations framework.
This change enable the seccrypt driver to work with multiple TrustZone
backends through a unified interface. The framework automatically
selects the appropriate backend (SCM or OP-TEE) at runtime based on
availability, maintaining backward compatibility with existing SCM-based
platforms while adding support for OP-TEE-based platforms.

Change-Id: Id798f37eb5d2fed176cd4ccd0db85c8b0894af49
Signed-off-by: Md Sadre Alam <mdalam@qti.qualcomm.com>
Signed-off-by: Ananya Ghosh <ananghos@qti.qualcomm.com>
---
 drivers/firmware/Kconfig  | 26 ++++++++++++++++++++++++++
 drivers/firmware/Makefile |  3 +++
 2 files changed, 29 insertions(+)

diff --git a/drivers/firmware/Kconfig b/drivers/firmware/Kconfig
index 8091a48e9621..65911e162fbd 100644
--- a/drivers/firmware/Kconfig
+++ b/drivers/firmware/Kconfig
@@ -255,8 +255,34 @@ config QCOM_ICE_TEE
 	  This backend uses the TEE bus framework to communicate with
 	  OPTEE for key management operations.
 
+config CRYPTO_DEV_QCOM_SECCRYPT_CORE
+	tristate "Qualcomm SecCrypt Core Layer"
+	help
+	  Core layer for SecCrypt backend management. This provides
+	  the abstraction layer for backend registration and operation
+	  forwarding to either SCM or OP-TEE backends.
+
+config CRYPTO_DEV_QCOM_SECCRYPT_SCM
+	tristate "Qualcomm SecCrypt SCM Backend"
+	depends on QCOM_SCM
+	select CRYPTO_DEV_QCOM_SECCRYPT_CORE
+	help
+	  TrustZone/SCM backend for SecCrypt. This backend uses the
+	  Qualcomm SCM (Secure Channel Manager) interface to communicate
+	  with TrustZone for secure crypto operations.
+
+config CRYPTO_DEV_QCOM_SECCRYPT_TEE
+	tristate "Qualcomm SecCrypt TEE Backend"
+	depends on OPTEE
+	select CRYPTO_DEV_QCOM_SECCRYPT_CORE
+	help
+	  TEE backend for SecCrypt. This backend uses the OP-TEE
+	  framework to communicate with the SecCrypt Trusted Application
+	  for secure crypto operations.
+
 config QCOM_SCM
 	select QCOM_PAS
+	select CRYPTO_DEV_QCOM_SECCRYPT_SCM
 	tristate
 
 config QCOM_SCM_DOWNLOAD_MODE_DEFAULT
diff --git a/drivers/firmware/Makefile b/drivers/firmware/Makefile
index fe56c2233140..335406492ca2 100644
--- a/drivers/firmware/Makefile
+++ b/drivers/firmware/Makefile
@@ -25,6 +25,9 @@ obj-$(CONFIG_QCOM_PAS_TEE)	+= qcom_pas_tee.o
 obj-$(CONFIG_QCOM_ICE_CORE)	+= qcom_ice_core.o
 obj-$(CONFIG_QCOM_ICE_SCM)	+= qcom_ice_scm.o
 obj-$(CONFIG_QCOM_ICE_TEE)	+= qcom_ice_tee.o
+obj-$(CONFIG_CRYPTO_DEV_QCOM_SECCRYPT_CORE) += qcom_seccrypt_core.o
+obj-$(CONFIG_CRYPTO_DEV_QCOM_SECCRYPT_SCM) += qcom_seccrypt_scm.o
+obj-$(CONFIG_CRYPTO_DEV_QCOM_SECCRYPT_TEE) += qcom_seccrypt_tee.o
 obj-$(CONFIG_SYSFB)		+= sysfb.o
 obj-$(CONFIG_SYSFB_SIMPLEFB)	+= sysfb_simplefb.o
 obj-$(CONFIG_TI_SCI_PROTOCOL)	+= ti_sci.o
-- 
