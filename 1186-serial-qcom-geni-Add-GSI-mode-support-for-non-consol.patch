+/* UART Config0 TRE */
+#define QCOM_GPI_UART_CONFIG0_TRE_DWORD0(pack, hunt, flags, parity, sbl, size) \
+	(((pack) << 24) | ((hunt) << 16) | ((flags) << 8) | ((parity) << 5) | \
+	((sbl) << 3) | (size))
+#define QCOM_GPI_UART_CONFIG0_TRE_DWORD1(rfr_level, rx_stale) \
+	(((rfr_level) << 24) | (rx_stale))
