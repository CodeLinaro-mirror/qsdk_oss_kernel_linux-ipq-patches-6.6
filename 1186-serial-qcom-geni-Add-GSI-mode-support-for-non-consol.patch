+	(((clk_source) << 16) | (clk_div))
+#define QCOM_GPI_UART_CONFIG0_TRE_DWORD3(link_rx, bei, ieot, ieob, ch) \
+	((0x2 << 20) | (0x2 << 16) | ((link_rx) << 11) | ((bei) << 10) | \
+	((ieot) << 9) | ((ieob) << 8) | (ch))
