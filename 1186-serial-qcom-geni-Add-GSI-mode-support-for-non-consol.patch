+
+#define QCOM_GPI_DMA_W_BUFFER_TRE_DWORD2(length) ((length) & 0xFFFFFF)
+#define QCOM_GPI_DMA_W_BUFFER_TRE_DWORD3(link_rx, bei, ieot, ieob, ch) \
