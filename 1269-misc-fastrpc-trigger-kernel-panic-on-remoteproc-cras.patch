From bb17ac7711c9fae94caf6b75944a77c9e5482eb4 Mon Sep 17 00:00:00 2001
From: Abhinav Parihar <parihar@qti.qualcomm.com>
Date: Thu, 18 Jun 2026 00:34:34 +0530
Subject: [PATCH] misc: fastrpc: trigger kernel panic on remoteproc crash

Register an atomic SSR notifier to handle remoteproc crash events.

On certain platforms, such as IPQ9650, a remoteproc crash may not
automatically trigger a kernel panic when recovery is disabled. This
behavior, prevents the collection of a full system dump, making it
difficult to triage remoteproc failures.

Introduce an atomic SSR notifier within the FastRPC driver to listen for
QCOM_SSR_NOTIFY_CRASH events. If a crash occurs and recovery is
explicitly disabled for the remoteproc (indicating a triage scenario),
the driver will manually invoke panic(). This ensures that system-level
dumps are captured for effective root cause analysis.

Change-Id: Icf62377d1be6e8112cc3d6e35e98f68094fd3be2
Signed-off-by: Abhinav Parihar <parihar@qti.qualcomm.com>
---
 drivers/misc/fastrpc.c | 62 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/drivers/misc/fastrpc.c b/drivers/misc/fastrpc.c
index 100070c1e307..f42d45c97dd7 100644
--- a/drivers/misc/fastrpc.c
+++ b/drivers/misc/fastrpc.c
@@ -25,6 +25,9 @@
 #include <linux/bitops.h>
 #include <linux/compiler.h>
 #include <linux/iopoll.h>
+#include <linux/iommu.h>
+#include <linux/remoteproc.h>
+#include <linux/remoteproc/qcom_rproc.h>
 
 #define ADSP_DOMAIN_ID (0)
 #define MDSP_DOMAIN_ID (1)
@@ -323,6 +326,9 @@ struct fastrpc_channel_ctx {
 	bool poll_mode_supported;
 	u64 dma_mask;
 	u64 jobid;
+	struct rproc *rproc;
+	struct notifier_block rproc_atomic_nb;
+	void *ssr_atomic_notifier;
 };
 
 struct fastrpc_device {
@@ -2563,6 +2569,26 @@ static int fastrpc_get_domain_id(const char *domain)
 	return -EINVAL;
 }
 
+/*
+ * The remoteproc SSR notifier chains are keyed by the PAS driver's
+ * ssr_name (see qcom_q6v5_pas.c), not by the generic "adsp"/"cdsp"/...
+ * domain label used in the fastrpc DT node, so the two must be mapped
+ * explicitly rather than reusing the domain label string.
+ */
+static const char *fastrpc_get_ssr_name(int domain_id)
+{
+	switch (domain_id) {
+	case ADSP_DOMAIN_ID:
+		return "lpass";
+	case SDSP_DOMAIN_ID:
+		return "dsps";
+	case CDSP_DOMAIN_ID:
+		return "cdsp";
+	default:
+		return NULL;
+	}
+}
+
 /*
  * Exception list for older platforms that use default_soc_data but whose
  * DSP firmware supports FastRPC polling mode.
@@ -2578,6 +2604,30 @@ static const char *const fastrpc_poll_supported_machines[] = {
 	"qcom,x1e80100", "qcom,x1p42100", "qcom,ipq9650", NULL,
 };
 
+static int  fastrpc_restart_notifier_cb(struct notifier_block *nb,
+					     unsigned long action, void *data)
+{
+	struct fastrpc_channel_ctx *cctx = container_of(nb, struct fastrpc_channel_ctx, rproc_atomic_nb);
+
+	pr_info("Received atomic event %lu for rproc: %s\n",
+		 action, cctx->rproc->name);
+
+	switch (action) {
+	case QCOM_SSR_NOTIFY_CRASH:
+		/* If rproc crashed and recovery is not enabled then create a kernel panic */
+		if (cctx->rproc->recovery_disabled) {
+			pr_err("Unhandled rproc fault, causing kernel panic (recovery disabled)");
+			panic("Unhandled rproc fault");
+		}
+		return NOTIFY_OK;
+
+	default:
+		return NOTIFY_DONE;
+	}
+
+	return NOTIFY_DONE;
+}
+
 static int fastrpc_rpmsg_probe(struct rpmsg_device *rpdev)
 {
 	struct device *rdev = &rpdev->dev;
@@ -2657,6 +2707,18 @@ static int fastrpc_rpmsg_probe(struct rpmsg_device *rpdev)
 		}
 	}
 
+	data->rproc_atomic_nb.notifier_call = fastrpc_restart_notifier_cb;
+	data->rproc_atomic_nb.priority = 1;
+	data->rproc = rproc_get_by_child(&rpdev->dev);
+	if (!data->rproc) {
+		dev_err(rdev, "Failed to find rproc for fastrpc device\n");
+		err = -EINVAL;
+		goto err_free_data;
+	}
+	data->ssr_atomic_notifier =
+			qcom_register_ssr_atomic_notifier(fastrpc_get_ssr_name(domain_id),
+							  &data->rproc_atomic_nb);
+
 	switch (domain_id) {
 	case ADSP_DOMAIN_ID:
 	case MDSP_DOMAIN_ID:
-- 
2.34.1

